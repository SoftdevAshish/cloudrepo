# Either a full URL...
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/todo
# ...or individual parts (used when DATABASE_URL is unset):
DB_DRIVER=sqlite
DB_NAME=todos.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=todo
# DB_PASSWORD=secret
# Extra named databases selectable per request with the X-Database header:
# DATABASES={"tenant_a":"postgresql+psycopg://u:p@host/a","tenant_b":"sqlite:///./b.db"}
# --- Auth ---
ENVIRONMENT=development            # "production" enforces a strong JWT secret
JWT_SECRET_KEY=dev-insecure-secret-do-not-use-in-production   # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# First admin, created on startup when both are set:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
